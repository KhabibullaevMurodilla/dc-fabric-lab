frr version 8.4
frr defaults traditional
hostname {{ inventory_hostname }}
log syslog informational
!
{# evpn_mh (Ethernet-Segment binding for EVPN multihoming) is defined in
   host_vars for leaf2/leaf3 but deliberately NOT rendered here: it requires
   a VLAN-aware Linux bridge, which this lab's kernel can't create (see
   docs/README.md). The commands below are what would be emitted on a
   kernel that supports it -- kept as a comment so the intended config is
   visible and correct, not silently dropped. #}
{% if evpn_mh is defined %}
! evpn mh es-sys-mac {{ evpn_mh.es_sys_mac }}  -- interface {{ evpn_mh.interface }}, needs VLAN-aware bridge (see README)
! evpn mh es-id {{ evpn_mh.es_id }}
{% endif %}
line vty
!
